# CAIA: alla miljövariabler koden läser. Kopiera till .env (eller till
# /etc/caia/caia.env på en server, se INSTALL.md) och fyll i. Inga riktiga
# värden här. Appen läser inte .env själv: servern (systemd EnvironmentFile,
# Vercels Environment Variables) sätter dem, och lokalt laddar du filen med
#   set -a; . ./.env; set +a
# tools/run_batch.py kan läsa den direkt med --env .env.

# --- Krävs alltid ---

# API-nyckel till OpenRouter, som förmedlar anropen till Claude-modellerna.
# Sätt en kreditgräns på nyckeln hos OpenRouter.
OPENROUTER_API_KEY=

# Vilken av OpenRouters ingångar anropen går till. eu: hela vägen genom
# OpenRouter stannar i EU (kräver OpenRouters Business-plan). Tom: den globala.
# Ett annat värde stoppar analysen med ett fel, aldrig en tyst global väg.
CAIA_OPENROUTER_REGION=

# Bara för batchkörningar (tools/run_batch.py), lämna tom i webbappen. Satt går
# alla anrop direkt till Anthropics API i stället för via OpenRouter, utan
# EU-ingång. Heter inte ANTHROPIC_API_KEY med flit.
CAIA_ANTHROPIC_API_KEY=

# Bara för batchkörningar, lämna tom i webbappen (den läser den aldrig).
# Kommaseparerade Anthropic-nycklar som provas i ordning före OpenRouter, som
# alltid är sist. En nyckel som svarar att krediterna är slut (eller 401/403)
# hoppas över i tio minuter. Sätts av scripts/max_credits_run.py med
# Max-abonnemangens månadskrediter. Går inte ihop med CAIA_ANTHROPIC_API_KEY.
CAIA_ANTHROPIC_KEYS=

# Vilken kommunprofil som körs. En av de två krävs, annars startar appen inte.
# CAIA_KOMMUN: namnet på en profil i src/caia/kommuner/ (till exempel exempel).
# CAIA_KOMMUN_DIR: sökväg till en profil utanför repot. Vinner över CAIA_KOMMUN.
CAIA_KOMMUN=exempel
CAIA_KOMMUN_DIR=

# --- Inloggning: Supabase (rekommenderas) ---

# Projektets adress, https://<projekt>.supabase.co. Satt = Supabase-inloggning.
SUPABASE_URL=
# Den publika nyckeln (anon eller sb_publishable_...). Syns i sidan, är inte hemlig.
SUPABASE_ANON_KEY=
# Bara för äldre projekt som signerar inloggningar med delad hemlighet (HS256).
SUPABASE_JWT_SECRET=
# 1 = fråga Supabase om inloggningar som appen inte kan kontrollera själv.
# Behövs bara om projektet signerar med något annat än ES256 eller HS256.
# Varje sådan begäran, även en påhittad som ser rätt ut, kostar ett anrop.
CAIA_AUTH_FALLBACK=
# Vilka konton som släpps in: adresser och/eller @domäner, kommaseparerade.
# * släpper in alla inloggade. Tom = ingen.
CAIA_ALLOWED_EMAILS=
# Adressen ett konto utanför listan ska skriva till. Tom = meddelandet säger
# bara vad som saknas.
CAIA_CONTACT=

# --- Inloggning: gemensamt lösenord (utan Supabase) ---

# Används bara när SUPABASE_URL är tom. Kräver CAIA_SECRET_KEY.
CAIA_PASSWORD=
# Signerar inloggningskakan. Samma värde i alla serverprocesser. Ta fram med
#   python3 -c "import secrets; print(secrets.token_hex(32))"
CAIA_SECRET_KEY=

# --- Valfria ---

# Modellanrop per användare (eller IP) och minut / dygn. Standard 20 och 150.
CAIA_RATE_LIMIT_PER_MIN=
CAIA_RATE_LIMIT_PER_DAY=
# Felaktiga lösenord från samma adress inom tio minuter innan inloggningen
# spärras (lösenordsläget). Standard 5. Höj för en workshop bakom ett gemensamt nät.
CAIA_LOGIN_FAILURES_PER_WINDOW=
# Antal proxyer framför appen som lägger till X-Forwarded-For. Standard 1
# (nginx, eller Vercel). Sätt 2 om till exempel en lastbalanserare står framför nginx.
CAIA_TRUSTED_PROXIES=
# 1 = inloggningskakan får gå över vanlig http. Bara för test i ett lokalt nät.
CAIA_INSECURE_COOKIE=
# 1 = ingen inloggning alls. ALDRIG i drift, bara på egen dator.
CAIA_DEV_OPEN=
# Sekunder varje låtsassteg väntar i tools/devserver.py. Bara för UI-arbete.
CAIA_STUB_DELAY=
# En sparad analys (mapp från tools/run_batch.py) som tools/devserver.py svarar ur i
# stället för testfixturerna. Bara för UI-arbete.
CAIA_DEV_RUN=

# --- Bara testsviten ---
# RUN_E2E=1 kör tests/test_e2e.py mot riktiga modeller (kostar ~2-3 USD).
# RUN_SUPABASE_IT=1 plus SUPABASE_URL och SUPABASE_SERVICE_ROLE_KEY kör
# tests/test_backend.py mot ett riktigt Supabase-projekt. Peka aldrig det mot
# produktionen: testet skriver en rad i reports.
# UPDATE_PROMPT_FINGERPRINTS=1 skriver om tests/fixtures/prompt-fingerprints.json
# (se docs/RUNBOOK.md, "Ändra en prompt").
# CI=true gör att sidtesterna fäller i stället för att hoppas över när node saknas.
